# PreTeXt build output
output/
*.log
logs/

# PreTeXt CLI local state
.ptx/
_build/

# NOTE: assets/generated/ is deliberately NOT ignored.
# Runestone builds from this repo and may not have Asymptote
# available. Committing generated images keeps the build portable.

