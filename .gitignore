.Rhistory
.RData
.Rproj.user/

# LaTeX intermediates (from pdf target)
*.aux
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk

# Editors
.vscode/
.idea/
*.swp
*~
\#*\#

